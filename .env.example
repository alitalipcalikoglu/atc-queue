# --- Server ---
PORT=3016
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TLS_CERT_PATH=
TLS_KEY_PATH=
# Empty = 2 x MAX_MESSAGE_BYTES (at least 1 MiB), so a batch of large messages fits.
BODY_LIMIT=

# --- Storage ---
DB_PATH=./data/queue.db
DB_BACKUP_DIR=

# --- Callers: id:secret[:role[:queue+queue]], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (browse, stats, metrics), write (enqueue, pull, ack, nack, extend), readwrite (both, the default),
# admin (everything, including queue settings, purge, redrive and deletes). The optional queue list scopes a key.
QUEUE_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS:admin,mailer:REPLACE_WITH_64_HEX_CHARS:write:emails
# Requests per key per minute (consumers pull often).
RATE_LIMIT_MAX=6000

# --- Limits ---
MAX_MESSAGE_BYTES=262144
# Messages (any state) per queue; enqueue answers 409 QUEUE_FULL above it.
MAX_QUEUE_DEPTH=100000
# Messages per batch enqueue or pull.
MAX_BATCH=100
# Longest long-poll of a pull, seconds (max 25).
MAX_WAIT_SEC=20
MAX_QUEUES=500
# Dead letters are deleted after this many days.
DEAD_RETENTION_DAYS=14
# How often expired leases are reclaimed, ms.
REAP_MS=1000

# --- Audit (optional): forward queue management events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-queue:…:write
AUDIT_URL=
AUDIT_API_KEY=
